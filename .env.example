AI_PROVIDER=google
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alternative to GEMINI_API_KEY.
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Optional OpenAI provider: set AI_PROVIDER=openai and fill these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Optional comma-separated extra frontend origins, for example http://localhost:5173
CORS_ORIGINS=
